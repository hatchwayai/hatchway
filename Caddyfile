# Caddyfile — Hatchway reverse proxy configuration
#
# Site names are supplied through HATCHWAY_API_DOMAIN and
# HATCHWAY_TUNNEL_DOMAIN.
# The DNS-01 challenge requires a custom Caddy build with the appropriate
# DNS provider plugin (see Dockerfile.caddy).

{$HATCHWAY_API_DOMAIN} {
	reverse_proxy hatchway-server:9000
}

*.{$HATCHWAY_TUNNEL_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# Authorize every HTTP request against Hatchway's database-clock tunnel
	# state before sending it to frps. header_up overwrites any client value.
	forward_auth hatchway-server:9001 {
		uri /internal/tunnels/authorize/{$HATCHWAY_PLUGIN_SECRET}
		header_up X-Hatchway-Tunnel-Host {http.request.host}
	}
	reverse_proxy frps:8081
}
