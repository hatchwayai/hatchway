# Hatchway server environment variables
# Copy this file to .env and fill in the values before running docker compose up.

# --- Required ---
# Your top-level domain (e.g. example.com)
HATCHWAY_DOMAIN=

# Cloudflare API token for DNS-01 challenge (wildcard cert for *.tunnel.<domain>)
# Needs Zone > Zone > Read and Zone > DNS > Edit for the target zone.
CLOUDFLARE_API_TOKEN=

# Strong password for PostgreSQL
POSTGRES_PASSWORD=

# Secret embedded in internal frps callback and Caddy request-gate paths.
# Shared only by frps, Caddy, and Hatchway; never returned to API users.
# Generate with: openssl rand -hex 32
HATCHWAY_PLUGIN_SECRET=

# frps↔frpc bootstrap secret. Returned to API users in the create-tunnel
# response so their frpc can authenticate to frps. Should be distinct from
# HATCHWAY_PLUGIN_SECRET. Generate with: openssl rand -hex 32
HATCHWAY_FRPS_AUTH_TOKEN=

# Both Hatchway service secrets must be different and contain 32-256
# URL-safe characters: letters, digits, underscores, or hyphens.

# --- Optional (with sensible defaults) ---
# PostgreSQL settings
POSTGRES_DB=hatchway
POSTGRES_USER=hatchway

# Domain overrides. Leave blank to derive api.<domain>, frps.<domain>, and
# tunnel.<domain> from HATCHWAY_DOMAIN.
HATCHWAY_API_DOMAIN=
HATCHWAY_FRPS_DOMAIN=
HATCHWAY_TUNNEL_DOMAIN=

# Server settings
HATCHWAY_MAX_CONCURRENT_TUNNELS=5
HATCHWAY_MAX_TTL=24h
HATCHWAY_RATE_CREATE_PER_MIN=10
HATCHWAY_MAX_REQUEST_BYTES=65536
HATCHWAY_API_READ_TIMEOUT=30s
HATCHWAY_API_WRITE_TIMEOUT=30s

# How long an frps callback or Caddy request-gate query may take. Timeouts fail
# closed, so don't set this below a typical DB query.
HATCHWAY_PLUGIN_TIMEOUT=2s

# Logging
HATCHWAY_LOG_USER_CONNS=false

# Retention
HATCHWAY_EVENTS_RETENTION_DAYS=30
HATCHWAY_IDEMPOTENCY_RETENTION_HOURS=24
HATCHWAY_RUNTIME_TOKEN_RETENTION_DAYS=7
