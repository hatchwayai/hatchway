# Custom Caddy image with Cloudflare DNS plugin for DNS-01 challenge.
# Change the plugin module if using a different DNS provider
# (e.g. github.com/caddy-dns/route53, github.com/caddy-dns/digitalocean).

FROM caddy:2.11.4-builder AS builder

RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2.11.4

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
